# Environment setup for the Talapas cluster (University of Oregon)
# source this file first in a sample argfile. Adjust module names to the current cluster setup.
if command -v module >/dev/null 2>&1; then
	module load bowtie2/2.4.4 2>/dev/null
	module load spack-rhel8 2>/dev/null && spack load 'samtools@1.16.1' arch=linux-rhel8-broadwell 2>/dev/null
	module load perl/5.24.2 2>/dev/null
	module load java 2>/dev/null
	module load R 2>/dev/null
fi
export PERL5LIB=""
PROGRAM_JUICER=${HOME}/Software/juicer/juicer_tools_1.22.01.jar
JAVA_MEM=100g
